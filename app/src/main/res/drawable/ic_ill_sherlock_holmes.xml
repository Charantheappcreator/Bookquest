<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="200dp"
    android:viewportWidth="320"
    android:viewportHeight="200">

    <!-- Victorian London Night & Fog Background -->
    <path
        android:pathData="M0,0 L320,0 L320,200 L0,200 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="160"
                android:startY="0"
                android:endX="160"
                android:endY="200"
                android:type="linear">
                <item android:offset="0.0" android:color="#0F172A"/>
                <item android:offset="0.5" android:color="#1E1B4B"/>
                <item android:offset="1.0" android:color="#312E81"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- London Skyline Silhouette: Big Ben & St. Paul's Dome in distance -->
    <path
        android:pathData="M20,130 L40,130 L40,90 L45,85 L45,60 L48,50 L51,60 L51,85 L56,90 L56,130 L80,130 L80,110 L100,110 L100,130 L160,130 Q180,95 200,130 L320,130 L320,200 L0,200 Z"
        android:fillColor="#1E293B"/>

    <!-- London Fog Swirls -->
    <path
        android:pathData="M0,140 Q60,120 120,135 T240,130 T320,140 L320,200 L0,200 Z"
        android:fillColor="#334155"/>

    <!-- Gas Streetlamp with Warm Glow -->
    <path
        android:pathData="M55,90 m-25,0 a25,25 0 1,1 50,0 a25,25 0 1,1 -50,0"
        android:fillColor="#30FDE047"/>
    <!-- Lamp post -->
    <path
        android:pathData="M53,95 L57,95 L57,185 L53,185 Z"
        android:fillColor="#020617"/>
    <!-- Lamp glass & cap -->
    <path
        android:pathData="M48,82 L62,82 L59,96 L51,96 Z"
        android:fillColor="#FEF08A"/>
    <path
        android:pathData="M46,80 L64,80 L55,70 Z"
        android:fillColor="#020617"/>

    <!-- SHERLOCK HOLMES SILHOUETTE & PROFILE -->
    <!-- Coat & Inverness Cape -->
    <path
        android:pathData="M185,110 C175,115 160,135 155,160 L150,195 L225,195 L220,160 C215,135 200,115 190,110 Z"
        android:fillColor="#0F172A"/>
    <!-- Inverness Cape Shoulder overlay -->
    <path
        android:pathData="M165,125 Q190,115 215,125 Q210,150 165,145 Z"
        android:fillColor="#1E293B"/>

    <!-- Sherlock Profile Head & Deerstalker Hat -->
    <path
        android:pathData="M188,88 m-12,0 a12,12 0 1,1 24,0 a12,12 0 1,1 -24,0"
        android:fillColor="#0F172A"/>
    <!-- Sharp Aquiline Nose & Chin Profile -->
    <path
        android:pathData="M178,84 L170,89 L176,92 L172,99 L180,100 Z"
        android:fillColor="#0F172A"/>
    <!-- Deerstalker Hat (Front visor, back flap, tied ribbons) -->
    <path
        android:pathData="M166,80 Q188,68 210,80 L214,84 L162,84 Z"
        android:fillColor="#334155"/>
    <path
        android:pathData="M188,70 L188,66 M186,66 L190,66"
        android:strokeWidth="2"
        android:strokeColor="#F59E0B"/>

    <!-- Classic Briar Tobacco Pipe -->
    <path
        android:pathData="M173,98 Q162,100 160,110 L166,110 Q168,103 175,100 Z"
        android:fillColor="#78350F"/>
    <path
        android:pathData="M158,106 L164,106 L164,114 L158,114 Z"
        android:fillColor="#92400E"/>
    <!-- Pipe Smoke trail -->
    <path
        android:pathData="M160,104 Q150,96 156,88 T150,76"
        android:strokeWidth="1.5"
        android:strokeColor="#CBD5E1"/>

    <!-- GIANT MAGNIFYING GLASS EXAMINING CLUE -->
    <!-- Handle -->
    <path
        android:pathData="M265,175 L285,195 L278,200 L258,180 Z"
        android:fillColor="#B45309"/>
    <!-- Brass rim -->
    <path
        android:pathData="M245,145 m-26,0 a26,26 0 1,1 52,0 a26,26 0 1,1 -52,0"
        android:strokeWidth="3.5"
        android:strokeColor="#F59E0B"
        android:fillColor="#1538BDF8"/>
    <!-- Lens Reflection -->
    <path
        android:pathData="M230,132 Q255,122 262,142"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"/>
    <!-- Secret Letter / Clue inside the lens! -->
    <path
        android:pathData="M236,138 L254,138 L254,154 L236,154 Z"
        android:fillColor="#FEF3C7"/>
    <path
        android:pathData="M239,142 L251,142 M239,146 L249,146 M239,150 L247,150"
        android:strokeWidth="1"
        android:strokeColor="#78350F"/>

    <!-- Cobblestones at Baker Street -->
    <path
        android:pathData="M0,188 L320,188 L320,200 L0,200 Z"
        android:fillColor="#090D16"/>

    <!-- Gilded Vintage Detective Frame -->
    <path
        android:pathData="M4,4 L316,4 L316,196 L4,196 Z"
        android:strokeWidth="2"
        android:strokeColor="#7C3AED"
        android:fillColor="#00000000"/>
    <path
        android:pathData="M8,8 L312,8 L312,192 L8,192 Z"
        android:strokeWidth="0.8"
        android:strokeColor="#FDE68A"
        android:fillColor="#00000000"/>
</vector>
