<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="200dp"
    android:viewportWidth="320"
    android:viewportHeight="200">

    <!-- Golden Sunset Ocean Background -->
    <path
        android:pathData="M0,0 L320,0 L320,200 L0,200 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="160"
                android:startY="0"
                android:endX="160"
                android:endY="200"
                android:type="linear">
                <item android:offset="0.0" android:color="#7C2D12"/>
                <item android:offset="0.4" android:color="#EA580C"/>
                <item android:offset="0.7" android:color="#FBBF24"/>
                <item android:offset="1.0" android:color="#0284C7"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing giant setting sun -->
    <path
        android:pathData="M160,115 m-36,0 a36,36 0 1,1 72,0 a36,36 0 1,1 -72,0"
        android:fillColor="#FEF08A"/>

    <!-- Tropical Island silhouette with palm trees -->
    <path
        android:pathData="M180,125 Q230,110 270,125 T320,130 L320,200 L180,200 Z"
        android:fillColor="#1C1917"/>
    <!-- Palm tree 1 -->
    <path
        android:pathData="M245,125 Q248,95 240,75"
        android:strokeWidth="3.5"
        android:strokeColor="#1C1917"/>
    <path
        android:pathData="M240,75 Q215,70 205,85 M240,75 Q235,55 220,55 M240,75 Q255,55 265,60 M240,75 Q265,75 270,90"
        android:strokeWidth="2.5"
        android:strokeColor="#1C1917"/>

    <!-- Rolling ocean waves -->
    <path
        android:pathData="M0,130 Q40,122 80,130 T160,130 T240,130 T320,130 L320,200 L0,200 Z"
        android:fillColor="#0369A1"/>
    <path
        android:pathData="M0,150 Q50,140 100,150 T200,150 T320,150 L320,200 L0,200 Z"
        android:fillColor="#075985"/>
    <path
        android:pathData="M0,175 Q60,165 120,175 T240,175 T320,175 L320,200 L0,200 Z"
        android:fillColor="#0C4A6E"/>

    <!-- TALL SAILING GALLEON PIRATE SHIP ON WAVES -->
    <!-- Wooden Ship Hull -->
    <path
        android:pathData="M50,140 Q85,155 125,140 L120,128 L45,128 Z"
        android:fillColor="#451A03"/>
    <!-- Center Mast -->
    <path
        android:pathData="M85,60 L85,130"
        android:strokeWidth="2.5"
        android:strokeColor="#78350F"/>
    <!-- Fore Mast -->
    <path
        android:pathData="M65,75 L65,130"
        android:strokeWidth="2"
        android:strokeColor="#78350F"/>
    <!-- White billowing square sails -->
    <path
        android:pathData="M70,70 Q85,65 100,70 L98,88 Q85,84 72,88 Z"
        android:fillColor="#FEF3C7"/>
    <path
        android:pathData="M68,92 Q85,86 102,92 L100,114 Q85,108 70,114 Z"
        android:fillColor="#FFFDF5"/>
    <path
        android:pathData="M52,82 Q65,78 78,82 L76,102 Q65,98 54,102 Z"
        android:fillColor="#FEF3C7"/>

    <!-- Black Pirate Flag with Skull & Crossbones atop main mast -->
    <path
        android:pathData="M85,60 L102,65 L85,70 Z"
        android:fillColor="#0F172A"/>
    <path
        android:pathData="M92,64 m-1.5,0 a1.5,1.5 0 1,1 3,0 a1.5,1.5 0 1,1 -3,0"
        android:fillColor="#FFFFFF"/>

    <!-- Antique Compass Rose in Corner -->
    <path
        android:pathData="M40,40 L44,48 L52,52 L44,56 L40,64 L36,56 L28,52 L36,48 Z"
        android:fillColor="#FBBF24"/>
    <path
        android:pathData="M40,52 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0"
        android:fillColor="#78350F"/>

    <!-- Gilded Adventure Frame -->
    <path
        android:pathData="M4,4 L316,4 L316,196 L4,196 Z"
        android:strokeWidth="2"
        android:strokeColor="#F59E0B"
        android:fillColor="#00000000"/>
    <path
        android:pathData="M8,8 L312,8 L312,192 L8,192 Z"
        android:strokeWidth="0.8"
        android:strokeColor="#FEF08A"
        android:fillColor="#00000000"/>
</vector>
